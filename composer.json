{
    "name": "coliving/api-guard",
    "description": "A simple way of authenticating your APIs with API keys using Laravel",
    "keywords": [
        "api",
        "rest",
        "json",
        "api keys",
        "api authentication",
        "laravel"
    ],
    "homepage": "https://github.com/dungnh/api-guard",
    "authors": [
        {
            "name": "Dzung Nguyen",
            "email": "dungnh@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "illuminate/support": "^5.4 | ^6.0 | ^7.0 | ^8.0 | ^9.0 | ^10.0 | ^11.0 | ^12.0 | ^13.0",
        "illuminate/database": "^5.4 | ^6.0| ^7.0 | ^8.0 | ^9.0 | ^10.0 | ^11.0 | ^12.0 | ^13.0",
        "ellipsesynergie/api-response": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^7.0 || ^8.0 || ^9.3 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Chrisbjr\\ApiGuard\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Chrisbjr\\ApiGuard\\Providers\\ApiGuardServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
